{
  "name": "magic-string-stack",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@11.18.0",
  "description": "magic-string with the capability of committing changes",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu/magic-string-stack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/magic-string-stack.git"
  },
  "bugs": "https://github.com/antfu/magic-string-stack/issues",
  "keywords": [
    "magic-string",
    "sourcemap"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "prepublishOnly": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "magic-string": "^1.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@antfu/ni": "^30.3.0",
    "@antfu/utils": "^9.3.0",
    "@types/node": "^26.1.2",
    "bumpp": "^12.1.1",
    "eslint": "^10.8.0",
    "lint-staged": "^17.2.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
